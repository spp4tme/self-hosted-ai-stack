(sso) {
  forward_auth authentik:9000 {
    uri /outpost.goauthentik.io/auth/caddy
    copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
    @goauthentik_proxy_response status 401 302
    handle_response @goauthentik_proxy_response {
      redir * https://authentik.local/outpost.goauthentik.io/start?rd={scheme}://{host}{uri}
    }
  }
}

# Retire les headers qui bloquent l'embedding dans les iframes Dashy
(allow_iframe) {
  header -X-Frame-Options
  header -Content-Security-Policy
}

dashboard.local {
  tls /certs/cert.pem /certs/key.pem
  root * /srv/dashboard
  file_server
}

webui.local {
  tls /certs/cert.pem /certs/key.pem
  reverse_proxy open-webui:8080
  import allow_iframe
}

litellm.local {
  tls /certs/cert.pem /certs/key.pem
  reverse_proxy litellm:4000
  import allow_iframe
}

